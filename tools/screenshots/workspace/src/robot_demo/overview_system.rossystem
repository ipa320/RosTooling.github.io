overview_system:
  nodes:
    "laser":
      from: "scanner_pkg.laser_driver"
      interfaces:
        - "scan": pub-> "laser_driver::scan"
    "filter":
      from: "scanner_pkg.scan_filter"
      interfaces:
        - "scan_in": sub-> "scan_filter::scan_in"
        - "scan_filtered": pub-> "scan_filter::scan_filtered"
    "detector":
      from: "nav_pkg.obstacle_detector"
      interfaces:
        - "scan_det": sub-> "obstacle_detector::scan"
  connections:
    - ["scan", "scan_in"]
    - ["scan_filtered", "scan_det"]
