btcpp_ros2_interfaces:
  msgs:
    NodeStatus
      message
        uint8 IDLE=0 uint8 RUNNING=1 uint8 SUCCESS=2 uint8 FAILURE=3 uint8 SKIPPED=4 uint8 status
  srvs:
    GetTrees
      request
      response
        string[] tree_ids
  actions:
    ExecuteTree
      goal
        string target_tree
        string payload
      result
        'btcpp_ros2_interfaces/msg/NodeStatus' node_status
        string return_message
      feedback
        string message
